{
  "name": "@masters/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests",
    "lint": "echo db-lint-pending",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "db:migrate": "tsx src/migrate.ts",
    "tenant-exports:cleanup": "tsx src/cleanup-tenant-exports.ts",
    "data-subject-delivery:cleanup": "tsx src/cleanup-data-subject-delivery-packages.ts",
    "privacy-capabilities:check": "tsx src/check-global-privacy-capabilities.ts",
    "retention:scan": "tsx src/run-retention-job.ts",
    "backup:bundle": "tsx src/create-backup-bundle.ts",
    "backup:verify": "tsx src/verify-backup-bundle.ts",
    "backup:stage": "tsx src/stage-backup-restore.ts",
    "backup:privacy-ledger": "tsx src/create-restore-privacy-ledger-snapshot.ts",
    "backup:privacy-reconcile": "tsx src/report-restore-privacy-reconciliation.ts",
    "backup:privacy-artifact-plan": "tsx src/prepare-restore-privacy-artifact-manifest.ts",
    "backup:privacy-replay-db": "tsx src/replay-restore-privacy-database.ts",
    "backup:privacy-artifact-replay": "tsx src/apply-restore-privacy-artifacts.ts",
    "backup:restore-healthcheck": "tsx src/report-restore-private-healthcheck.ts",
    "backup:restore-recovery-plan": "tsx src/prepare-restore-private-recovery-plan.ts",
    "backup:restore-recovery-execute": "tsx src/execute-restore-private-recovery.ts",
    "backup:restore-promotion-intent": "tsx src/authorize-restore-private-promotion.ts",
    "backup:restore-promotion-preflight": "tsx src/preflight-restore-private-promotion.ts"
  },
  "dependencies": {
    "@libsql/client": "^0.17.4",
    "@masters/domain": "workspace:*",
    "drizzle-orm": "^0.45.2"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "drizzle-kit": "^0.31.4",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  },
  "exports": "./src/index.ts",
  "types": "./src/index.ts"
}
