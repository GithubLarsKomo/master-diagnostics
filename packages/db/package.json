{
  "name": "@masters/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests",
    "lint": "echo db-lint-pending",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "db:migrate": "tsx src/migrate.ts",
    "tenant-exports:cleanup": "tsx src/cleanup-tenant-exports.ts",
    "data-subject-delivery:cleanup": "tsx src/cleanup-data-subject-delivery-packages.ts",
    "privacy-capabilities:check": "tsx src/check-global-privacy-capabilities.ts",
    "retention:scan": "tsx src/run-retention-job.ts",
    "backup:bundle": "tsx src/create-backup-bundle.ts"
  },
  "dependencies": {
    "@libsql/client": "^0.17.4",
    "@masters/domain": "workspace:*",
    "drizzle-orm": "^0.45.2"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "drizzle-kit": "^0.31.4",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  },
  "exports": "./src/index.ts",
  "types": "./src/index.ts"
}
