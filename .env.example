# deployment: club | saas
DEPLOYMENT_MODE=club
AUTH_PROVIDER=better-auth

# Public hostname used by Caddy. For a local HTTP-only test use localhost.
APP_HOST=diagnostics.example.org
NEXT_PUBLIC_APP_URL=https://diagnostics.example.org
BETTER_AUTH_URL=https://diagnostics.example.org

# Docker Compose overrides this with http://libsql:8080 inside the stack.
DATABASE_URL=http://localhost:8080
DATABASE_AUTH_TOKEN=

# Generate with: openssl rand -base64 48
BETTER_AUTH_SECRET=replace-with-at-least-32-random-bytes
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
DEFAULT_TIMEZONE=Europe/Berlin
DEFAULT_LOCALE=de
LOG_LEVEL=info
