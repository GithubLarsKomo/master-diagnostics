# deployment: club | saas
DEPLOYMENT_MODE=club
AUTH_PROVIDER=better-auth

# Public hostname used by Caddy. For a local HTTP-only test use localhost.
APP_HOST=diagnostics.example.org
NEXT_PUBLIC_APP_URL=https://diagnostics.example.org
BETTER_AUTH_URL=https://diagnostics.example.org

# Docker Compose overrides this with http://libsql:8080 inside the legacy rollback stack.
# PostgreSQL production deployments use .env.postgres.example instead.
DATABASE_URL=http://localhost:8080
DATABASE_AUTH_TOKEN=

# Generate with: openssl rand -base64 48
BETTER_AUTH_SECRET=replace-with-at-least-32-random-bytes
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
DEFAULT_TIMEZONE=Europe/Berlin
DEFAULT_LOCALE=de
LOG_LEVEL=info

# Epic-12 encrypted club backups. Use absolute host paths.
# Generate the separate backup key file with: openssl rand -base64 32
BACKUP_HOST_DIR=/var/backups/master-diagnostics
BACKUP_KEY_FILE=/etc/master-diagnostics/backup.key
# Number of newest complete .mdbak + .sha256 pairs retained after a successful legacy backup.
BACKUP_RETENTION_COUNT=30
# Plaintext restore staging is isolated from production volumes and chmod 0700 by the staging helper.
RESTORE_STAGING_HOST_DIR=/var/lib/master-diagnostics/restore-staging
# Privacy replay never mutates the extracted staging copy directly. A private per-staging workspace
# is created below this root with copies of libsql, reports, tenant-exports and data-subject-delivery.
# The replay manifest is captured there before DB metadata is removed; only this workspace becomes writable.
RESTORE_PRIVACY_REPLAY_HOST_DIR=/var/lib/master-diagnostics/restore-privacy-replay
# Signed restore-privacy ledgers are stored outside both backup history and restore staging.
# Use a separate 32-byte Base64 HMAC key; do not reuse the backup encryption key.
RESTORE_PRIVACY_LEDGER_HOST_DIR=/var/lib/master-diagnostics/restore-privacy-ledger
RESTORE_PRIVACY_LEDGER_KEY_FILE=/etc/master-diagnostics/restore-privacy-ledger.key
# Privacy-effective anonymization commits are journaled outside backup history before/after the DB commit.
# Use another separate 32-byte Base64 HMAC key; do not reuse backup or ledger keys.
RESTORE_PRIVACY_EFFECT_JOURNAL_HOST_DIR=/var/lib/master-diagnostics/restore-privacy-effect-journal
RESTORE_PRIVACY_EFFECT_JOURNAL_KEY_FILE=/etc/master-diagnostics/restore-privacy-effect-journal.key
# Private restore recovery uses a fourth independent HMAC key for the immutable PENDING execution intent.
# Generate with: openssl rand -base64 32. Do not reuse backup, ledger or privacy-effect-journal keys.
RESTORE_PRIVATE_RECOVERY_INTENT_KEY_FILE=/etc/master-diagnostics/restore-private-recovery-intent.key
# Private restore promotion uses a fifth independent HMAC key for the immutable promotion authorization.
# Generate with: openssl rand -base64 32. Do not reuse backup, ledger, journal or recovery keys.
RESTORE_PRIVATE_PROMOTION_INTENT_KEY_FILE=/etc/master-diagnostics/restore-private-promotion.key
# The pre-cutover switch journal is durable host evidence outside the mutable private restore workspace.
# Each candidate set receives its own 0700 subdirectory below this root.
RESTORE_PRIVATE_PROMOTION_SWITCH_JOURNAL_HOST_DIR=/var/lib/master-diagnostics/restore-promotion-switch-journal
# Practical restore/RTO drills persist technical signed reports outside staging/replay workspaces.
# Use a sixth independent 32-byte Base64 HMAC key; a successful report never enables backup privacy automatically.
RESTORE_RTO_DRILL_REPORT_HOST_DIR=/var/lib/master-diagnostics/restore-rto-drills
RESTORE_RTO_DRILL_REPORT_KEY_FILE=/etc/master-diagnostics/restore-rto-drill-report.key
# Manual backup-privacy activation attestations are separate operator evidence.
# Use a seventh independent 32-byte Base64 HMAC key; do not reuse the RTO drill report key.
BACKUP_PRIVACY_MANUAL_ATTESTATION_HOST_DIR=/var/lib/master-diagnostics/backup-privacy-attestations
BACKUP_PRIVACY_MANUAL_ATTESTATION_KEY_FILE=/etc/master-diagnostics/backup-privacy-manual-attestation.key

# Global privacy runtime attestation. Missing declarations block irreversible
# anonymization. DISABLED means the corresponding external feature is not in use.
PRIVACY_BACKUP_STATE=DISABLED
PRIVACY_NOTIFICATIONS_STATE=DISABLED

# When PRIVACY_BACKUP_STATE=ENABLED, all values below are mandatory and must
# describe the actually deployed backup/restore controls.
# Do not enable these merely because backup creation/scheduling exists; restore
# reconciliation must also be deployed and tested.
# PRIVACY_BACKUP_POLICY_VERSION=1.0.0
# PRIVACY_BACKUP_ENCRYPTED_AT_REST=true
# PRIVACY_BACKUP_BOUNDED_RETENTION_CONFIGURED=true
# PRIVACY_BACKUP_RESTORE_RECONCILIATION=true

# When PRIVACY_NOTIFICATIONS_STATE=ENABLED, all values below are mandatory and
# describe the actually deployed notification controls.
# PRIVACY_NOTIFICATIONS_POLICY_VERSION=1.0.0
# PRIVACY_NOTIFICATIONS_SUBJECT_SCOPED_PAYLOAD=true
# PRIVACY_NOTIFICATIONS_DIRECT_IDENTIFIERS_FORBIDDEN=true
# PRIVACY_NOTIFICATIONS_SUBJECT_CLEANUP_SUPPORTED=true
