From: OpenAI <noreply@openai.com>
Date: Mon, 20 Jul 2026 20:46:16 +0000
Subject: [PATCH] fix: align toolchain tests and TypeScript config

---
 apps/web/vitest.config.ts          |  7 +++++++
 package.json                       |  6 ++++++
 packages/auth/tsconfig.json        | 12 +++++++++++-
 packages/db/package.json           |  3 ++-
 packages/db/tsconfig.json          | 16 +++++++++++++++-
 packages/diagnostics/tsconfig.json | 13 ++++++++++++-
 packages/domain/tsconfig.json      | 12 +++++++++++-
 packages/sync/tsconfig.json        | 12 +++++++++++-
 8 files changed, 75 insertions(+), 6 deletions(-)
 create mode 100644 apps/web/vitest.config.ts

diff --git a/apps/web/vitest.config.ts b/apps/web/vitest.config.ts
new file mode 100644
index 0000000..adc30f1
--- /dev/null
+++ b/apps/web/vitest.config.ts
@@ -0,0 +1,7 @@
+import { defineConfig } from 'vitest/config';
+
+export default defineConfig({
+  test: {
+    exclude: ['e2e/**', 'node_modules/**', '.next/**'],
+  },
+});
diff --git a/package.json b/package.json
index 956e70a..8c24f36 100644
--- a/package.json
+++ b/package.json
@@ -16,5 +16,11 @@
   "devDependencies": {
     "typescript": "^7.0.2",
     "turbo": "^2.5.6"
+  },
+  "pnpm": {
+    "onlyBuiltDependencies": [
+      "esbuild",
+      "sharp"
+    ]
   }
 }
diff --git a/packages/auth/tsconfig.json b/packages/auth/tsconfig.json
index c34c87e..85852f0 100644
--- a/packages/auth/tsconfig.json
+++ b/packages/auth/tsconfig.json
@@ -1 +1,11 @@
-{"extends":"../config/tsconfig.base.json","compilerOptions":{"outDir":"dist","declaration":true},"include":["src/**/*.ts"]}
+{
+  "extends": "../config/tsconfig.base.json",
+  "compilerOptions": {
+    "outDir": "dist",
+    "declaration": true,
+    "rootDir": "."
+  },
+  "include": [
+    "src/**/*.ts"
+  ]
+}
diff --git a/packages/db/package.json b/packages/db/package.json
index d163e5c..d0116b6 100644
--- a/packages/db/package.json
+++ b/packages/db/package.json
@@ -20,7 +20,8 @@
     "drizzle-kit": "^0.31.4",
     "tsx": "^4.20.6",
     "typescript": "^7.0.2",
-    "vitest": "^4.1.10"
+    "vitest": "^4.1.10",
+    "@types/node": "^24.0.0"
   },
   "exports": "./src/index.ts",
   "types": "./src/index.ts"
diff --git a/packages/db/tsconfig.json b/packages/db/tsconfig.json
index 4617082..54df6e3 100644
--- a/packages/db/tsconfig.json
+++ b/packages/db/tsconfig.json
@@ -1 +1,15 @@
-{"extends":"../config/tsconfig.base.json","compilerOptions":{"outDir":"dist","declaration":true},"include":["src/**/*.ts","drizzle.config.ts"]}
+{
+  "extends": "../config/tsconfig.base.json",
+  "compilerOptions": {
+    "outDir": "dist",
+    "declaration": true,
+    "rootDir": ".",
+    "types": [
+      "node"
+    ]
+  },
+  "include": [
+    "src/**/*.ts",
+    "drizzle.config.ts"
+  ]
+}
